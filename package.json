{
  "name": "cssx-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "benchmark": "pnpm --dir benchmarks benchmark",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:unit && pnpm test:package-contract",
    "test:unit": "vitest run --exclude packages/cssx/test/package-contract.test.ts",
    "test:package-contract": "pnpm build && vitest run packages/cssx/test/package-contract.test.ts",
    "test:visual": "pnpm --dir tests test",
    "test:visual:update": "pnpm --dir tests test:update",
    "test:release": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm test:package-contract && pnpm typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude packages/cssx/test/package-contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/types": "^7.29.8",
    "@rspack/core": "^2.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.3",
    "eslint-plugin-jsdoc": "^60.8.3",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.7",
    "webpack": "^5.110.1"
  }
}
