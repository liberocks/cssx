{
  "name": "cssx-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "benchmark": "pnpm --dir benchmarks benchmark",
    "benchmark:vite": "pnpm --dir benchmarks benchmark:vite",
    "benchmark:dev-hmr": "vitest run packages/unplugin/src/transforms/project-scan.integration.test.ts -t 'measures 30 warm cached edits' --reporter=verbose",
    "build:packages": "node scripts/build-packages.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:tailwind-corpus": "pnpm --filter @cssxio/compiler build && node scripts/generate-tailwind-conformance.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:package-contract",
    "test:unit": "vitest run --maxWorkers=2 --exclude packages/cssx/src/package-contract.test.ts --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --maxWorkers=2 packages/unplugin/src/adapters/development-coordinator.integration.test.ts packages/unplugin/src/adapters/next-development-server.integration.test.ts packages/unplugin/src/transforms/project-scan.integration.test.ts packages/unplugin/src/transforms/project-scan-races.integration.test.ts packages/unplugin/src/transforms/project-scan-watcher.integration.test.ts",
    "test:e2e": "pnpm test:visual",
    "test:package-contract": "pnpm build:packages && pnpm --filter @cssxio/docs run build && vitest run --maxWorkers=2 packages/cssx/src/package-contract.test.ts",
    "test:hmr": "pnpm --dir tests test:hmr",
    "test:visual": "pnpm --dir tests test",
    "test:visual:update": "pnpm --dir tests test:update",
    "test:release": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm test:package-contract && pnpm typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=2 --exclude packages/cssx/src/package-contract.test.ts && node scripts/test-intellisense-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "generate:intellisense-catalog": "node scripts/generate-intellisense-catalog.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.8",
    "@rspack/core": "^2.2.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^60.8.3",
    "prettier": "^3.9.6",
    "rollup": "^4.63.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.42",
    "webpack": "^5.110.3"
  }
}
