{
  "name": "@cssxio/unplugin",
  "version": "0.12.1",
  "description": "Universal bundler plugin for CSSX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liberocks/cssx.git",
    "directory": "packages/unplugin"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js",
      "require": "./dist/rollup.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./next-loader": {
      "types": "./dist/next-loader.d.ts",
      "import": "./dist/next-loader.js",
      "require": "./dist/next-loader.cjs"
    },
    "./internal/development-runtime": {
      "types": "./dist/development-runtime.d.ts",
      "import": "./dist/development-runtime.js",
      "require": "./dist/development-runtime.cjs"
    },
    "./internal/transform-runtime": {
      "types": "./dist/transform-runtime.d.ts",
      "import": "./dist/transform-runtime.js",
      "require": "./dist/transform-runtime.cjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "require": "./dist/rspack.cjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "require": "./dist/esbuild.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts src/rollup.ts src/webpack.ts src/rspack.ts src/esbuild.ts src/next.ts src/next-loader.ts src/development-runtime.ts src/transform-runtime.ts src/unplugin-factory-runtime.ts --format esm,cjs --dts --minify --external @cssxio/unplugin/internal/development-runtime --external @cssxio/unplugin/internal/transform-runtime --clean"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@cssxio/babel-plugin": "^0.11.0",
    "@cssxio/compiler": "^0.12.0",
    "@vue/compiler-sfc": "^3.5.0",
    "magic-string": "^0.30.21",
    "unplugin": "^3.3.0"
  },
  "optionalDependencies": {
    "@cssxio/compiler-native": "^0.2.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
