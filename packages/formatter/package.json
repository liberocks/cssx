{
  "name": "@cssxio/formatter",
  "version": "0.2.3",
  "description": "CSSX-aware utility formatter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liberocks/cssx.git",
    "directory": "packages/formatter"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "cssx-format": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/write-build-manifest.mjs"
  },
  "dependencies": {
    "@cssxio/compiler": "^0.16.0",
    "oxc-parser": "^0.156.0",
    "tinyglobby": "^0.2.17"
  },
  "optionalDependencies": {
    "@cssxio/compiler-native": "^0.3.1"
  }
}
