---
import BaseLayout from './BaseLayout.astro';
import { sx } from '@cssxio/cssx';
---

<BaseLayout title="CSSX Docs">
  <header
    class={sx(
      'sticky top-0 z-10 flex min-h-16 items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 xs:px-5 sm:px-6 dark:border-slate-800 dark:bg-slate-900',
    )}
  >
    <slot name="header" />
  </header>
  <div class={sx('block min-h-[calc(100vh-4rem)] md:grid md:grid-cols-4')}>
    <aside
      class={sx(
        'border-b border-slate-200 bg-white p-4 xs:p-5 sm:p-6 md:sticky md:top-16 md:self-start md:border-r md:border-b-0 dark:border-slate-800 dark:bg-slate-900',
      )}
    >
      <slot name="sidebar" />
    </aside>
    <main class={sx('min-w-0 p-4 xs:p-5 sm:p-6 md:col-span-3')}>
      <slot />
    </main>
  </div>
</BaseLayout>
