---
import BaseLayout from './BaseLayout.astro';
import DocsIcon from '../components/DocsIcon.astro';
import { sx } from '@cssxio/cssx';

interface Props {
  title?: string;
  sidebar?: boolean;
}

const { title = 'Documentation — CSSX', sidebar: showSidebar = true } = Astro.props;
const docsHref = (hash: string) => `${showSidebar ? '' : '/docs/'}#${hash}`;

const groups = [
  {
    title: 'Guides',
    links: [
      ['Introduction', 'overview'],
      ['Quickstart', 'quickstart'],
      ['Build integration', 'configuration'],
      ['Styling patterns', 'patterns'],
    ],
  },
  {
    title: 'Reference',
    links: [
      ['Runtime API', 'reference'],
      ['sx', 'sx'],
      ['create', 'create'],
      ['props', 'props'],
    ],
  },
  {
    title: 'Resources',
    links: [
      ['Packages', 'packages'],
      ['Next steps', 'next-steps'],
    ],
  },
];
---

<BaseLayout title={title}>
  <div class:list={['docs-shell', { 'docs-shell-wide': !showSidebar }]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class:list={['docs-header', sx('sticky top-0 z-10')]}>
      <a class="docs-brand" href="/" aria-label="CSSX home">cssx<span>docs</span></a>
      <div class="docs-toolbar">
        <button class="search-trigger" type="button" data-open-search aria-label="Search documentation">
          <DocsIcon name="magnifying-glass" /><span>Find something...</span><kbd>⌘ K</kbd>
        </button>
        <nav class="top-links" aria-label="Primary navigation">
          <a href="/docs/" aria-current={showSidebar ? 'page' : undefined}>Documentation</a>
          <a href="https://github.com/liberocks/cssx">GitHub</a>
        </nav>
        <button class="icon-button theme-button" type="button" data-docs-theme aria-label="Switch to dark theme">
          <span class="sun-icon"><DocsIcon name="sun" /></span>
          <span class="moon-icon"><DocsIcon name="moon" /></span>
        </button>
        <a class="header-cta" href={docsHref('quickstart')}>Get started</a>
        {
          showSidebar && (
            <button
              class="icon-button menu-button"
              type="button"
              data-menu-toggle
              aria-label="Open navigation"
              aria-expanded="false"
              aria-controls="docs-sidebar"
            >
              <DocsIcon name="bars-3" />
            </button>
          )
        }
      </div>
    </header>
    {
      showSidebar && (
        <aside class="docs-sidebar" id="docs-sidebar">
          <nav aria-label="Documentation navigation">
            {groups.map((group) => (
              <div class="nav-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.links.map(([label, id]) => (
                    <li>
                      <a href={`#${id}`} data-docs-link aria-current={id === 'overview' ? 'location' : undefined}>
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
          <div class="sidebar-note">
            Built with CSSX<span>Documentation and API reference.</span>
          </div>
        </aside>
      )
    }
    <main id="main-content" class="docs-main">
      <div class="docs-decoration" aria-hidden="true">
        <div class="docs-glow"><img src="/images/protocol-grid.svg" alt="" /></div>
      </div><slot />
    </main>
    <div hidden data-search-index>
      {groups.flatMap((group) => group.links).map(([label, id]) => <a href={docsHref(id)}>{label}</a>)}
    </div>
    <dialog class="search-dialog" aria-labelledby="search-title">
      <form method="dialog" class="search-heading">
        <DocsIcon name="magnifying-glass" />
        <label class="sr-only" id="search-title" for="docs-search">Search documentation</label>
        <input id="docs-search" type="search" placeholder="Search documentation..." autocomplete="off" />
        <button type="submit" class="search-close" aria-label="Close search">Esc</button>
      </form>
      <div class="search-results" aria-live="polite"></div>
      <div class="search-hint">Search guides, API methods, and packages</div>
    </dialog>
  </div>
</BaseLayout>

<style is:global>
  .docs-shell {
    --docs-bg: #fff;
    --docs-text: #18181b;
    --docs-muted: #52525b;
    --docs-line: #e9e9ec;
    --docs-subtle: #fafafa;
    --docs-green: #059669;
    min-height: 100vh;
    background: var(--docs-bg);
    color: var(--docs-text);
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }
  [data-theme='dark'] .docs-shell {
    --docs-bg: #18181b;
    --docs-text: #fafafa;
    --docs-muted: #a1a1aa;
    --docs-line: #ffffff0f;
    --docs-subtle: #ffffff04;
    --docs-green: #34d399;
  }
  .docs-shell a {
    text-decoration: none;
  }
  .docs-shell button {
    cursor: pointer;
  }
  .docs-shell :focus-visible {
    outline: 2px solid var(--docs-green);
    outline-offset: 4px;
  }
  .docs-shell svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .docs-shell .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 12px;
    z-index: 50;
    padding: 12px;
    background: var(--docs-bg);
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: none;
  }
  .docs-header {
    height: 56px;
    display: flex;
    border-bottom: 1px solid var(--docs-line);
    background: var(--docs-bg);
  }
  .docs-brand {
    width: 320px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 24px;
    font-size: 25px;
    font-weight: 750;
    letter-spacing: -1.5px;
    border-right: 1px solid var(--docs-line);
  }
  .docs-brand span {
    color: var(--docs-muted);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0;
    border: 1px solid var(--docs-line);
    border-radius: 5px;
    padding: 2px 6px;
  }
  .docs-toolbar {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 32px;
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 448px;
    height: 34px;
    padding: 0 12px;
    border: 1px solid var(--docs-line);
    border-radius: 999px;
    color: var(--docs-muted);
    text-align: left;
    font-size: 14px;
    box-shadow: 0 1px 3px #00000004;
  }
  .search-trigger svg {
    width: 16px;
    color: #a1a1aa;
  }
  .search-trigger kbd {
    margin-left: auto;
    color: #a1a1aa;
    font-size: 12px;
  }
  .top-links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    color: var(--docs-muted);
  }
  .top-links a:hover {
    color: var(--docs-green);
  }
  .icon-button {
    min-width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--docs-muted);
  }
  .icon-button:hover {
    background: var(--docs-subtle);
  }
  .theme-button {
    border-left: 1px solid var(--docs-line);
    border-radius: 0;
    padding-left: 20px;
    width: 44px;
  }
  .header-cta,
  .docs-primary {
    background: var(--docs-text);
    color: var(--docs-bg);
    border-radius: 999px;
    padding: 7px 14px;
    white-space: nowrap;
    font-size: 14px;
  }
  .menu-button,
  .moon-icon {
    display: none;
  }
  [data-theme='dark'] .sun-icon {
    display: none;
  }
  [data-theme='dark'] .moon-icon {
    display: block;
  }
  .docs-sidebar {
    position: fixed;
    top: 56px;
    bottom: 0;
    width: 320px;
    border-right: 1px solid var(--docs-line);
    padding: 24px;
    overflow-y: auto;
    background: var(--docs-bg);
    z-index: 9;
  }
  .nav-group {
    margin-bottom: 32px;
  }
  .nav-group h2 {
    font-size: 13px;
    font-weight: 600;
    padding: 0 8px;
    margin-bottom: 12px;
  }
  .nav-group ul {
    list-style: none;
    margin: 0 0 0 16px;
    padding: 0;
    border-left: 1px solid var(--docs-line);
  }
  .nav-group a {
    display: block;
    padding: 7px 16px;
    line-height: 20px;
    color: var(--docs-muted);
    border-left: 1px solid transparent;
    margin-left: -1px;
  }
  .nav-group a:hover {
    color: var(--docs-text);
    background: var(--docs-subtle);
  }
  .nav-group a[aria-current] {
    color: var(--docs-green);
    background: var(--docs-subtle);
    border-left-color: var(--docs-green);
    border-radius: 0 6px 6px 0;
  }
  .sidebar-note {
    border-top: 1px solid var(--docs-line);
    padding: 24px 8px 0;
    margin-top: 40px;
    font-size: 12px;
    color: var(--docs-muted);
  }
  .sidebar-note span {
    display: block;
    margin-top: 6px;
    color: #71717a;
  }
  .docs-main {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-left: 320px;
    padding: 64px 32px 32px;
  }
  .docs-decoration {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    top: -56px;
    left: 50%;
    margin-left: -608px;
    width: 1300px;
    height: 400px;
  }
  .docs-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right in oklab, #36b49f, #dbff75);
    mask-image: radial-gradient(farthest-side at top, white, transparent);
    opacity: 0.22;
  }
  .docs-glow img {
    position: absolute;
    top: -50%;
    width: 100%;
    height: 200%;
    transform: skewY(-18deg);
    mix-blend-mode: overlay;
  }
  [data-theme='dark'] .docs-glow {
    opacity: 0.12;
  }
  .docs-article {
    max-width: 1056px;
    margin: 0 auto;
  }
  .docs-article h1 {
    font-size: 24px;
    line-height: 32px;
    font-weight: 650;
    letter-spacing: -0.6px;
    margin: 0 0 12px;
  }
  .docs-article h2 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    letter-spacing: -0.4px;
    margin: 0 0 12px;
  }
  .docs-article h3 {
    font-size: 14px;
    line-height: 24px;
    font-weight: 600;
    margin: 0 0 6px;
  }
  .docs-article p {
    color: var(--docs-muted);
    font-size: 16px;
    line-height: 28px;
    margin: 0;
    max-width: 800px;
  }
  .docs-article section,
  .docs-article header,
  .docs-article [id] {
    scroll-margin-top: 96px;
  }
  .docs-intro {
    max-width: 800px;
  }
  .docs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
    align-items: center;
  }
  .docs-primary,
  .docs-secondary,
  .docs-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .docs-primary svg,
  .docs-link svg {
    width: 15px;
    height: 15px;
  }
  .docs-primary:hover {
    opacity: 0.8;
  }
  .docs-secondary {
    border: 1px solid var(--docs-line);
    border-radius: 999px;
    padding: 6px 14px;
  }
  .docs-secondary:hover {
    background: var(--docs-subtle);
  }
  .docs-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--docs-green);
  }
  .docs-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .docs-section {
    margin-top: 64px;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    border-top: 1px solid var(--docs-line);
    padding-top: 36px;
    margin-top: 20px;
  }
  .guide-grid p {
    font-size: 14px;
    line-height: 24px;
    margin-bottom: 18px;
  }
  .guide-grid .docs-link {
    margin-top: auto;
  }
  .guide-grid > div {
    display: flex;
    flex-direction: column;
  }
  .reference-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .reference-card {
    border: 1px solid var(--docs-line);
    border-radius: 16px;
    padding: 24px;
    background: var(--docs-subtle);
  }
  .reference-card p {
    font-size: 14px;
    line-height: 24px;
  }
  .reference-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--docs-line);
    border-radius: 50%;
    margin-bottom: 16px;
    color: var(--docs-green);
    background: var(--docs-bg);
  }
  .reference-card:hover {
    border-color: var(--docs-green);
  }
  .docs-code {
    position: relative;
    background: #18181b;
    border: 1px solid #ffffff14;
    border-radius: 14px;
    margin-top: 24px;
    color: #e4e4e7;
    overflow: hidden;
  }
  .code-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    border-bottom: 1px solid #ffffff14;
    font-size: 12px;
    color: #a1a1aa;
  }
  .copy-code {
    color: #d4d4d8;
    padding: 5px 7px;
    border-radius: 4px;
  }
  .copy-code:hover {
    background: #ffffff0f;
  }
  .docs-code pre {
    padding: 20px;
    margin: 0;
    overflow-x: auto;
    font-size: 13px;
    line-height: 24px;
    tab-size: 2;
  }
  .docs-article :not(pre) > code {
    font-size: 0.875em;
    color: var(--docs-text);
    background: var(--docs-subtle);
    border: 1px solid var(--docs-line);
    padding: 2px 5px;
    border-radius: 4px;
  }
  .api-method {
    border-top: 1px solid var(--docs-line);
    padding-top: 28px;
    margin-top: 28px;
  }
  .api-method h3 {
    font-family: monospace;
    font-size: 16px;
  }
  .docs-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    border-top: 1px solid var(--docs-line);
    padding-top: 24px;
    font-size: 12px;
    color: var(--docs-muted);
  }
  .search-dialog {
    position: fixed;
    inset: 100px 16px auto;
    padding: 0;
    margin: 0 auto;
    width: 560px;
    max-width: calc(100% - 32px);
    border: 1px solid var(--docs-line);
    border-radius: 16px;
    color: var(--docs-text);
    background: var(--docs-bg);
    box-shadow: 0 24px 80px #0003;
  }
  .search-dialog::backdrop {
    background: #18181b66;
    backdrop-filter: blur(4px);
  }
  .search-heading {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid var(--docs-line);
  }
  .search-heading input {
    flex: 1;
    min-width: 0;
    background: transparent;
    outline: none;
    font-size: 16px;
  }
  .search-close {
    border: 1px solid var(--docs-line);
    border-radius: 5px;
    padding: 3px 6px;
    font-size: 11px;
  }
  .search-results {
    max-height: 50vh;
    overflow: auto;
    padding: 8px;
  }
  .search-results a {
    display: block;
    padding: 12px;
    border-radius: 8px;
  }
  .search-results a:hover,
  .search-results a:focus {
    background: var(--docs-subtle);
    color: var(--docs-green);
  }
  .search-results p {
    padding: 24px 12px;
    color: var(--docs-muted);
  }
  .search-hint {
    padding: 12px 20px;
    border-top: 1px solid var(--docs-line);
    font-size: 12px;
    color: var(--docs-muted);
  }
  @media (max-width: 1279px) {
    .docs-brand,
    .docs-sidebar {
      width: 256px;
    }
    .docs-main {
      margin-left: 256px;
      padding: 48px 40px 32px;
    }
    .docs-toolbar {
      gap: 20px;
    }
    .search-trigger {
      width: 320px;
    }
    .top-links {
      gap: 20px;
    }
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 1023px) {
    .top-links {
      display: none;
    }
    .search-trigger {
      width: auto;
      flex: 1;
    }
    .docs-toolbar {
      gap: 16px;
      padding: 0 24px;
    }
    .docs-main {
      padding: 40px 32px;
    }
  }
  @media (max-width: 767px) {
    .docs-brand {
      width: auto;
      padding: 0 20px;
      border: 0;
    }
    .docs-toolbar {
      padding: 0 16px 0 4px;
      gap: 8px;
    }
    .docs-brand span,
    .header-cta,
    .search-trigger kbd {
      display: none;
    }
    .search-trigger {
      border: 0;
      padding: 0 8px;
      box-shadow: none;
    }
    .search-trigger span {
      font-size: 12px;
    }
    .theme-button {
      border: 0;
      padding: 0;
      width: 36px;
    }
    .menu-button {
      display: grid;
    }
    .docs-toolbar .icon-button {
      min-width: 44px;
      height: 44px;
    }
    .search-trigger {
      min-width: 44px;
      min-height: 44px;
    }
    .docs-sidebar {
      display: none;
      width: min(320px, 100%);
      box-shadow: 16px 0 40px #0001;
    }
    .docs-sidebar[data-open] {
      display: block;
    }
    .docs-main {
      margin-left: 0;
      padding: 40px 24px 24px;
    }
    .docs-section {
      margin-top: 48px;
    }
    .guide-grid {
      gap: 28px 24px;
      padding-top: 28px;
    }
    .reference-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 399px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
    .search-trigger span {
      display: none;
    }
  }
  .docs-shell-wide .docs-main {
    margin-left: 0;
    min-height: calc(100vh - 56px);
  }
  .docs-shell-wide .docs-brand {
    width: auto;
    border-right: 0;
  }
  .docs-shell-wide .docs-toolbar {
    padding-left: 16px;
  }
  .docs-shell-wide .top-links {
    display: flex;
  }
  @media (max-width: 767px) {
    .docs-shell-wide .top-links {
      margin-left: auto;
      font-size: 12px;
    }
    .docs-shell-wide .top-links a[href^='https:'] {
      display: none;
    }
    .docs-shell-wide .search-trigger {
      flex: 0;
    }
    .docs-shell-wide .search-trigger span {
      display: none;
    }
    .docs-shell-wide .docs-toolbar {
      padding-left: 0;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = document.querySelector<HTMLInputElement>('#docs-search')!;
  const results = document.querySelector<HTMLElement>('.search-results')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-docs-link]')];
  const sidebar = document.querySelector<HTMLElement>('#docs-sidebar');
  const searchLinks = [
    ...document.querySelector<HTMLElement>('[data-search-index]')!.querySelectorAll<HTMLAnchorElement>('a'),
  ];
  const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const themeButton = document.querySelector<HTMLButtonElement>('[data-docs-theme]')!;

  function renderResults() {
    const query = input.value.toLowerCase().trim();
    const matches = searchLinks.filter((link) => {
      const section = document.querySelector(link.hash);
      return `${link.textContent} ${section?.textContent ?? ''}`.toLowerCase().includes(query);
    });
    results.replaceChildren();
    for (const link of matches) {
      const result = document.createElement('a');
      result.href = link.getAttribute('href')!;
      result.textContent = link.textContent;
      result.addEventListener('click', () => dialog.close());
      results.append(result);
    }
    if (!matches.length) {
      const empty = document.createElement('p');
      empty.textContent = 'No results found. Try “styles”, “Vite”, or “sx”.';
      results.append(empty);
    }
  }
  function openSearch() {
    renderResults();
    dialog.showModal();
    input.focus();
  }
  document.querySelector('[data-open-search]')?.addEventListener('click', openSearch);
  input.addEventListener('input', renderResults);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      results.querySelector('a')?.focus();
    }
    if (event.key === 'Enter') {
      event.preventDefault();
      results.querySelector('a')?.click();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else openSearch();
    }
    if (event.key === 'Escape') closeMenu();
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  function closeMenu() {
    sidebar?.removeAttribute('data-open');
    menu?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-label', 'Open navigation');
  }
  menu?.addEventListener('click', () => {
    const open = sidebar?.toggleAttribute('data-open');
    menu?.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  });
  links.forEach((link) => link.addEventListener('click', closeMenu));
  document.querySelector('.docs-main')?.addEventListener('click', closeMenu);
  function updateActive() {
    const hash = location.hash || '#overview';
    links.forEach((link) => {
      if (link.hash === hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  window.addEventListener('hashchange', updateActive);
  updateActive();
  function updateThemeLabel() {
    themeButton.setAttribute(
      'aria-label',
      document.documentElement.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }
  themeButton.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    try {
      localStorage.setItem('cssx-theme', theme);
    } catch {
      /* Theme still works when storage is unavailable. */
    }
    updateThemeLabel();
  });
  updateThemeLabel();
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.closest('.docs-code')!.querySelector('code')!.textContent!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select code to copy';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
      }, 2000);
    });
  });
</script>
