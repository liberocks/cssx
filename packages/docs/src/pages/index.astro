---
import { sx } from '@cssxio/cssx';

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const logos = [
  { src: '/images/logos/react.svg', name: 'React' },
  { src: '/images/logos/expo.svg', name: 'Expo' },
  { src: '/images/logos/svelte.svg', name: 'Svelte' },
  { src: '/images/logos/solid.svg', name: 'Solid' },
  { src: '/images/logos/astro.svg', name: 'Astro' },
  { src: '/images/logos/gatsby.svg', name: 'Gatsby' },
  { src: '/images/logos/electron.svg', name: 'Electron' },
  { src: '/images/logos/html.svg', name: 'HTML' },
  { src: '/images/logos/nextjs.svg', name: 'Next.js' },
  { src: '/images/logos/remix.svg', name: 'Remix' },
  { src: '/images/logos/vite.svg', name: 'Vite' },
  { src: '/images/logos/vue.svg', name: 'Vue' },
];
---

<BaseLayout title="cssx">
  <div class={sx('max-w-full mx-auto md:max-w-xl min-h-screen flex flex-col justify-center p-4')}>
    <div class={sx('flex flex-col gap-10')}>
      <div>
        <img src="/images/logo.png" alt="Logo" class={sx('w-auto h-8 opacity-80 dark:invert')} />
      </div>

      <h1 class={sx('text-2xl text-gray-900 dark:text-gray-50')}>
        The leanest style engine in the internet for your ultrafast applications<sup>*</sup>
      </h1>

      <p class={sx('text-lg font-light text-gray-600 dark:text-gray-300')}>
        Don’t let boilerplate ship to production. On average, one-third of your app’s CSS goes unused. <span
          class={sx('font-mono')}>cssx</span
        > strips unused styles, minifies the rest, and eliminates long utility class names in production while keeping your
        development experience intact. In your editor, you’ll still see the full, readable CSS class utilities you know and love.
      </p>

      <p class={sx('text-xs -mt-5 tracking-wider text-gray-400')}>
        <sup>*</sup>Our benchmark said so, but you should benchmark yourself to make sure.
      </p>

      <div>
        <a
          class={sx(
            'bg-black dark:bg-white dark:text-black text-white text-base font-light px-6 py-2.5 rounded-full tracking-wide hover:bg-black/50 dark:hover:bg-white/50',
          )}
          href="/docs">Read Documentation</a
        >
      </div>

      <div class={sx('flex flex-col gap-5')}>
        <div class={sx('flex items-center')}>
          <div class={sx('mt-0.5 border-t border-solid border-gray-300 dark:border-gray-700 w-full')}></div>
          <p class={sx('font-light text-sm text-gray-600 dark:text-gray-300 text-center min-w-30')}>
            <span class={sx('font-mono')}>cssx</span> works with
          </p>
          <div class={sx('mt-0.5 border-t border-solid border-gray-300 dark:border-gray-700 w-full')}></div>
        </div>
        <div
          class:list={[
            'group',
            sx(
              'relative flex overflow-hidden mask-[linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]',
            ),
          ]}
        >
          <div
            class={sx(
              'flex w-[max-content] shrink-0 animate-marquee group-hover:animation-paused motion-reduce:animation-name-none grayscale dark:invert',
            )}
          >
            {
              [0, 1].map((half) => (
                <div class={sx('flex shrink-0 gap-10 pr-10')} aria-hidden={half === 1}>
                  {logos.map((logo) => (
                    <img src={logo.src} alt={logo.name} class={sx('h-10 w-auto')} />
                  ))}
                </div>
              ))
            }
          </div>
        </div>
        <div class={sx('mt-2 border-t border-solid border-gray-300 dark:border-gray-700 w-full')}></div>
      </div>

      <div class={sx('flex flex-row-reverse justify-between items-center gap-4')}>
        <ThemeToggle />

        <div class={sx('flex justify-start items-center gap-4')}>
        <a href="https://github.com/liberocks/cssx"
          ><Icon name="brand-github" class={sx('w-6 h-6 text-gray-600 dark:text-gray-300')} /></a
        >
        <a href="https://www.npmjs.com/package/@cssxio/cssx"
          ><Icon name="brand-npm" class={sx('w-6 h-6 text-gray-600 dark:text-gray-300')} /></a
        >
        <a href="https://x.com/liberocks"
          ><Icon name="brand-x" class={sx('w-6 h-6 text-gray-600 dark:text-gray-300')} /></a
        >
        <a href="#"><Icon name="brand-vscode" class={sx('w-6 h-6 text-gray-600 dark:text-gray-300')} /></a></div>
      </div>
    </div>
  </div>
</BaseLayout>
