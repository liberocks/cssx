---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { classes } from '../../styles';
---

<DocsLayout title="Editor support" description="CSSX IntelliSense shows completion and hover help for static utility strings.">
  <header><p class={classes.eyebrow}>Getting started</p><h1 class={classes.title}>Editor support</h1><p class={classes.lead}>CSSX IntelliSense shows completion and hover help for static utility strings.</p></header>
  <section class={classes.section}><h2 class={classes.heading}>Supported contexts</h2><ul class={classes.list}><li class={classes.listItem}>cssx.create and cx calls.</li><li class={classes.listItem}>class and className attributes.</li><li class={classes.listItem}>JavaScript, TypeScript, JSX, Astro, Vue, Svelte, and HTML files.</li></ul></section>
</DocsLayout>
