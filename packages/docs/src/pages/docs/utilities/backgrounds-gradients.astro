---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { classes } from '../../../styles';
---
<DocsLayout title="Backgrounds and gradients" description="Background layers, colors, and linear gradients.">
  <header>
    <p class={classes.eyebrow}>Utility reference</p>
    <h1 class={classes.title}>Backgrounds and gradients</h1>
    <p class={classes.lead}>Background layers, colors, and linear gradients.</p>
  </header>
  <section class={classes.section}>
    <h2 class={classes.heading}>Classes</h2>
    <p class={classes.copy}>bg-*, bg-position-*, bg-size-*, bg-repeat-*, bg-clip-*, bg-origin-*, bg-linear-*, from-*, via-*, to-*, text-*, accent-*, caret-*, fill-*, and stroke-*.</p>
  </section>
  <section class={classes.section}>
    <h2 class={classes.heading}>Color scales</h2>
    <p class={classes.copy}>Every default color scale has shades from 50 through 950. Additional scales are blue-gray, brown, deep-orange, light-green, light-blue, and deep-purple. Hyphenated names work with every color utility.</p>
    <pre class={classes.code}><code>bg-deep-orange-500 text-blue-gray-950 border-light-green-200{`\n`}from-light-blue-400 via-deep-purple-500 to-brown-700</code></pre>
  </section>
</DocsLayout>
