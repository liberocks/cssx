---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { classes } from '../../../styles';
---
<DocsLayout title="Typography" description="Font, text, decoration, list, and content utilities."><header><p class={classes.eyebrow}>Utility reference</p><h1 class={classes.title}>Typography</h1><p class={classes.lead}>Font, text, decoration, list, and content utilities.</p></header><section class={classes.section}><h2 class={classes.heading}>Classes</h2><p class={classes.copy}>font-*, font-[value], font-(--property), text-*, leading-*, tracking-*, tab-*, italic, antialiased, numeric variants, truncate, whitespace-*, wrap-*, hyphens-*, underline, decoration-*, list-*, line-clamp-*, and content-*.</p></section><section class={classes.section}><h2 class={classes.heading}>Writing and rendering</h2><pre class={classes.code}><code>writing-vertical-rl text-orientation-upright text-combine-upright-all{`\n`}unicode-bidi-isolate image-render-pixelated font-optical-auto font-kerning-normal</code></pre><p class={classes.copy}>Writing modes include horizontal-tb, vertical-rl, and vertical-lr. Font synthesis supports none, weight, style, small-caps, and position.</p></section></DocsLayout>
