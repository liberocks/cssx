---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { classes } from '../../styles';
---

<DocsLayout title="Integrations" description="Use the adapter entrypoint for the build tool that compiles your app.">
  <header><p class={classes.eyebrow}>Getting started</p><h1 class={classes.title}>Integrations</h1><p class={classes.lead}>Use the adapter entrypoint for the build tool that compiles your app.</p></header>
  <section class={classes.section}><h2 class={classes.heading}>Adapter entrypoints</h2><pre class={classes.code}><code>import vite from '@cssxio/unplugin/vite';
import rollup from '@cssxio/unplugin/rollup';
import webpack from '@cssxio/unplugin/webpack';
import rspack from '@cssxio/unplugin/rspack';
import esbuild from '@cssxio/unplugin/esbuild';</code></pre></section>
  <section class={classes.section}><h2 class={classes.heading}>Options</h2><ul class={classes.list}><li class={classes.listItem}>importSource changes the runtime module to transform.</li><li class={classes.listItem}>cssFileName sets a relative CSS file path and supports [hash].</li><li class={classes.listItem}>theme and themeFile provide CSSX theme input. Do not use both.</li><li class={classes.listItem}>layer wraps the output in a CSS layer.</li></ul></section>
</DocsLayout>
