---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { classes } from '../../styles';
---

<DocsLayout title="Installation" description="Add the CSSX runtime, configure one adapter, and link the CSS file.">
  <header>
    <p class={classes.eyebrow}>Getting started</p>
    <h1 class={classes.title}>Installation</h1>
    <p class={classes.lead}>Add the CSSX runtime, configure one adapter, and link the CSS file.</p>
  </header>
  <section class={classes.section}>
    <h2 class={classes.heading}>Install packages</h2>
    <pre class={classes.code}><code>pnpm add @cssxio/cssx
pnpm add -D @cssxio/unplugin</code></pre>
  </section>
  <section class={classes.section}>
    <h2 class={classes.heading}>Configure the adapter</h2>
    <pre class={classes.code}><code>import cssx from '@cssxio/unplugin/vite';

export default {`{`}
  plugins: [cssx({`{`} cssFileName: 'assets/cssx.css' {`}`})],
{`}`};</code></pre>
  </section>
  <section class={classes.section}>
    <h2 class={classes.heading}>Link the stylesheet</h2>
    <p class={classes.copy}>Keep this link in your app document during development and production.</p>
    <pre class={classes.code}><code>&lt;link rel="stylesheet" href="/assets/cssx.css" /&gt;</code></pre>
  </section>
</DocsLayout>
