---
import type { DocLocale, DocPage } from '../../docs/catalog.ts';
import DocsShell from './DocsShell.astro';
import { docsStyleProps } from '../../styles/docs.ts';

interface Props {
  page: DocPage;
  pages: DocPage[];
  lang: DocLocale;
}

const { page, pages, lang } = Astro.props;
const Content = page.Content;
---

<DocsShell title={page.data.title} lang={lang} pages={pages} currentId={page.id} headings={page.data.headings}>
  <article class={docsStyleProps.prose.className}>
    <p>{page.data.section}</p>
    <h1>{page.data.title}</h1>
    <p>{page.data.description}</p>
    <div class={docsStyleProps.content.className}>
      <Content lang={lang} />
    </div>
  </article>
</DocsShell>
