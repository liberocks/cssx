---
import { sx } from '@cssxio/cssx';
import type { DocHeading, DocLocale, DocPage } from '../../docs/catalog.ts';
import { defaultLocale } from '../../localization/index.ts';
import DocsNavigation from '../../components/DocsNavigation.astro';
import DocsSearch from '../../components/DocsSearch.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';

interface Props {
  title: string;
  lang: DocLocale;
  pages: DocPage[];
  currentId?: string;
  headings?: readonly DocHeading[];
}

const { title, lang, pages, currentId, headings = [] } = Astro.props;
const homePath = lang === defaultLocale ? '/' : `/${lang}`;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
---

<DocsLayout title={`${title} | CSSX`} lang={lang}>
  <div id="top" class={sx('box-border px-6 pt-22 pb-4 max-md:px-4 max-md:pt-19')}>
    <header
      class={sx(
        'fixed inset-x-6 top-4 z-50 mx-auto grid h-12 max-w-7xl',
        'grid-cols-(--docs-grid-columns) items-center gap-x-8 bg-white dark:bg-neutral-950',
        'max-docs:flex max-docs:justify-between max-docs:gap-6',
        'max-md:inset-x-4 max-md:top-3',
      )}
    >
      <a class={sx('col-start-1 inline-flex items-center')} href={homePath}>
        <img src="/images/logo.png" alt="CSSX home" class={sx('h-6 w-auto max-md:h-5')} />
      </a>
      <DocsNavigation variant="mobile" pages={pages} lang={lang} currentId={currentId} />
      <div class={sx('col-start-3 flex items-center gap-4 justify-self-start pl-2 max-docs:ml-auto max-docs:pl-0 max-md:gap-2')}>
        <DocsSearch pages={pages} lang={lang} />
        <LanguageToggle />
        <ThemeToggle />
      </div>
    </header>
    <div
      class={sx(
        'relative z-0 grid w-full max-w-7xl grid-cols-(--docs-grid-columns) gap-8 mx-auto',
        'max-docs:grid-cols-[13rem minmax(0,1fr)] max-md:block',
      )}
    >
      <DocsNavigation variant="desktop" pages={pages} lang={lang} currentId={currentId} />
      <main class={sx('col-start-2 min-w-0 pb-16')}><slot /></main>
      {tocHeadings.length > 0 && (
        <aside
          class={sx(
            'fixed top-22 bottom-4 [right:max(1.5rem,calc((100vw - var(--container-7xl))/2))] z-10',
            'box-border w-48 pl-2',
            'max-docs:hidden',
          )}
          aria-label="On this page"
        >
          <h2 class={sx('m-0 mb-3 text-xs font-semibold uppercase tracking-wider text-gray-900 dark:text-gray-50')}>On this page</h2>
          <nav class={sx('flex flex-col gap-2 border-l border-gray-200 pl-3 dark:border-gray-800')}>
            <a class={sx('text-sm leading-normal text-gray-500 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-50')} href="#top">(Top)</a>
            {tocHeadings.map((heading) => (
              <a
                class={sx('text-sm leading-normal text-gray-500 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-50', 'data-[depth=3]:pl-2')}
                href={`#${heading.slug}`}
                data-depth={heading.depth}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </div>
</DocsLayout>
