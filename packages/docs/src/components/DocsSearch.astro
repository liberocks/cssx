---
import * as cssx from '@cssxio/cssx';

import Icon from './Icon.astro';
import { styles } from './DocsSearch.styles.ts';
import type { Locale } from '../localization/index.ts';
import { defaultLocale } from '../localization/index.ts';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang } = Astro.props;
const docsPath = lang === defaultLocale ? '/docs' : `/${lang}/docs`;
const searchId = 'docs-search';
const items = [
  ['Quick Start', 'quick-start'],
  ['Menu', 'menu'],
  ['Dropdown', 'dropdown'],
  ['Button', 'button'],
  ['Input', 'input'],
  ['Styling', 'quick-start'],
  ['Animation', 'menu'],
  ['Composition', 'dropdown'],
  ['Forms', 'button'],
  ['llms.txt', 'input'],
] as const;
---

<div data-docs-search class={Astro.props.class ?? ''}>
  <button type="button" aria-haspopup="dialog" aria-controls={searchId} {...cssx.props(styles.trigger)} data-docs-search-trigger>
    <span>Search</span>
    <kbd {...cssx.props(styles.shortcut)}>⌘ K</kbd>
  </button>
  <dialog id={searchId} aria-label="Search documentation" {...cssx.props(styles.dialog)} data-docs-search-dialog>
    <div {...cssx.props(styles.content)}>
      <div {...cssx.props(styles.searchRow)}>
        <input type="search" placeholder="Search documentation" autocomplete="off" {...cssx.props(styles.input)} data-docs-search-input />
        <button type="button" aria-label="Close search" {...cssx.props(styles.closeButton)} data-docs-search-close>
          <Icon name="x" {...cssx.props(styles.closeIcon)} />
        </button>
      </div>
      <div {...cssx.props(styles.results)} data-docs-search-results>
        {items.map(([label, slug]) => (
          <a href={`${docsPath}/${slug}`} {...cssx.props(styles.result)} data-docs-search-item>{label}</a>
        ))}
        <p {...cssx.props(styles.empty)} data-docs-search-empty hidden>No matching pages.</p>
      </div>
    </div>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll('[data-docs-search]')) {
    const trigger = root.querySelector('[data-docs-search-trigger]');
    const dialog = root.querySelector('[data-docs-search-dialog]');
    const input = root.querySelector('[data-docs-search-input]');
    const closeButton = root.querySelector('[data-docs-search-close]');
    const empty = root.querySelector('[data-docs-search-empty]');
    const items = root.querySelectorAll('[data-docs-search-item]');

    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !(closeButton instanceof HTMLButtonElement) || !(empty instanceof HTMLElement)) continue;

    const filterItems = () => {
      const query = input.value.trim().toLowerCase();
      let matches = 0;

      items.forEach((item) => {
        const isMatch = item.textContent?.toLowerCase().includes(query) ?? false;
        item.toggleAttribute('hidden', !isMatch);
        if (isMatch) matches += 1;
      });

      empty.hidden = matches !== 0;
    };

    const openSearch = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
    };

    trigger.addEventListener('click', openSearch);
    closeButton.addEventListener('click', () => dialog.close());
    input.addEventListener('input', filterItems);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      input.value = '';
      filterItems();
      trigger.focus();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openSearch();
      }
    });
  }
</script>
