---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../localization/index.ts';
import { defaultLocale } from '../localization/index.ts';

interface Props {
  pages: CollectionEntry<'docs'>[];
  lang: Locale;
}

const { pages, lang } = Astro.props;
const docsPath = lang === defaultLocale ? '/docs' : `/${lang}/docs`;
const items = pages
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .map((page) => ({
    title: page.data.title,
    section: page.data.section,
    href: `${docsPath}/${page.id}`,
    search: `${page.data.title} ${page.data.description} ${page.data.keywords.join(' ')} ${page.body ?? ''}`.toLowerCase(),
  }));
---

<div class="docs-search" data-docs-search>
  <button type="button" aria-haspopup="dialog" aria-controls="docs-search-dialog" data-search-open>
    Search <kbd>⌘ K</kbd>
  </button>
  <dialog id="docs-search-dialog" aria-label="Search documentation" data-search-dialog>
    <div class="docs-search-panel">
      <label class="visually-hidden" for="docs-search-input">Search documentation</label>
      <input id="docs-search-input" type="search" placeholder="Search documentation and utilities" autocomplete="off" data-search-input />
      <button type="button" aria-label="Close search" data-search-close>Close</button>
      <nav aria-label="Search results" data-search-results>
        {items.map((item) => (
          <a href={item.href} data-search-item data-search={item.search}>
            <span>{item.title}</span>
            <small>{item.section}</small>
          </a>
        ))}
        <p data-search-empty hidden>No matching documentation.</p>
      </nav>
    </div>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll('[data-docs-search]')) {
    const trigger = root.querySelector('[data-search-open]');
    const dialog = root.querySelector('[data-search-dialog]');
    const input = root.querySelector('[data-search-input]');
    const close = root.querySelector('[data-search-close]');
    const empty = root.querySelector('[data-search-empty]');
    const results = [...root.querySelectorAll('[data-search-item]')];

    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !(close instanceof HTMLButtonElement) || !(empty instanceof HTMLElement)) continue;

    const filter = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const result of results) {
        const text = result.getAttribute('data-search') ?? '';
        const visible = terms.every((term) => text.includes(term));
        result.toggleAttribute('hidden', !visible);
        if (visible) count += 1;
      }
      empty.hidden = count > 0;
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
    };

    trigger.addEventListener('click', open);
    close.addEventListener('click', () => dialog.close());
    input.addEventListener('input', filter);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      input.value = '';
      filter();
      trigger.focus();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      }
    });
  }
</script>

<style>
  .docs-search > button {
    min-height: 2.5rem;
    border: 1px solid #e5e5e5;
    border-radius: 0.5rem;
    background: transparent;
    padding: 0.45rem 0.7rem;
    color: #525252;
    font: inherit;
    cursor: pointer;
  }

  .docs-search kbd {
    margin-left: 0.5rem;
    border: 1px solid #d4d4d4;
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    font-size: 0.75rem;
  }

  .docs-search dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(80dvh, 42rem);
    margin: auto;
    border: 1px solid #e5e5e5;
    border-radius: 0.9rem;
    background: white;
    padding: 0;
    color: #171717;
    box-shadow: 0 2rem 5rem #0003;
  }

  .docs-search dialog::backdrop {
    background: #0007;
  }

  .docs-search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: 1rem;
  }

  .docs-search input {
    min-width: 0;
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    padding: 0.7rem;
    font: inherit;
  }

  .docs-search-panel > button {
    border: 0;
    border-radius: 0.5rem;
    background: #f5f5f5;
    padding: 0 0.75rem;
    cursor: pointer;
  }

  .docs-search nav {
    display: flex;
    max-height: 60dvh;
    grid-column: 1 / -1;
    flex-direction: column;
    overflow: auto;
  }

  .docs-search nav a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 0.5rem;
    padding: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .docs-search nav a:hover {
    background: #f5f5f5;
  }

  .docs-search nav small,
  .docs-search nav p {
    color: #737373;
  }

  .docs-search nav p {
    margin: 0;
    padding: 1rem;
    text-align: center;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global([data-theme='dark']) .docs-search > button {
    border-color: #404040;
    color: #d4d4d4;
  }

  :global([data-theme='dark']) .docs-search dialog {
    border-color: #404040;
    background: #171717;
    color: #fafafa;
  }

  :global([data-theme='dark']) .docs-search-panel > button,
  :global([data-theme='dark']) .docs-search nav a:hover {
    background: #262626;
    color: #fafafa;
  }

  :global([data-theme='dark']) .docs-search input {
    border-color: #525252;
    background: #171717;
    color: #fafafa;
  }
</style>
