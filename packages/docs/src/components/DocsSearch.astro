---
import { sx } from '@cssxio/cssx';
import type { DocLocale, DocPage } from '../docs/catalog.ts';
import Icon from './Icon.astro';

interface Props {
  pages: DocPage[];
  lang: DocLocale;
}

const { pages, lang } = Astro.props;
const docsPath = lang === 'en' ? '/docs' : `/${lang}/docs`;
const items = pages
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .map((page) => ({
    title: page.data.title,
    section: page.data.section,
    href: `${docsPath}/${page.id}`,
    search: `${page.data.title} ${page.data.description} ${page.data.keywords.join(' ')} ${page.data.searchText}`.toLowerCase(),
  }));
---

<div class={sx('flex items-center')} data-docs-search>
  <button
    class={sx('grid h-6 w-6 shrink-0 place-items-center border-0 bg-transparent p-0 text-inherit cursor-pointer')}
    type="button"
    aria-label="Search documentation"
    aria-haspopup="dialog"
    aria-controls="docs-search-dialog"
    data-search-open
  >
    <Icon name="search" class={sx('w-5 h-5 text-gray-600 dark:text-gray-300')} />
  </button>
  <dialog
    class={sx(
      'm-auto w-11/12 max-w-2xl max-h-[80dvh] rounded-2xl border border-gray-200 bg-white p-0 text-gray-900 shadow-xl',
      '[&::backdrop]:bg-black/45 dark:border-gray-700 dark:bg-neutral-900 dark:text-gray-50',
    )}
    id="docs-search-dialog"
    aria-label="Search documentation"
    data-search-dialog
  >
    <div class={sx('flex flex-wrap gap-3 p-4')}>
      <label class={sx('sr-only')} for="docs-search-input">Search documentation</label>
      <input
        class={sx('min-w-0 flex-1 rounded-lg border border-gray-300 px-3 py-3 font-(--font-sans) text-base dark:border-gray-600 dark:bg-neutral-900 dark:text-gray-50')}
        id="docs-search-input"
        type="search"
        placeholder="Search documentation and utilities"
        autocomplete="off"
        data-search-input
      />
      <button class={sx('rounded-lg border-0 bg-gray-100 px-3 py-3 text-gray-900 cursor-pointer dark:bg-neutral-800 dark:text-gray-50')} type="button" aria-label="Close search" data-search-close>Close</button>
      <nav class={sx('flex max-h-[60dvh] basis-full flex-col overflow-auto')} aria-label="Search results" data-search-results>
        {items.map((item) => (
          <a
            class={sx('flex justify-between gap-4 rounded-lg p-3 text-inherit no-underline hover:bg-gray-100 dark:hover:bg-neutral-800')}
            href={item.href}
            data-search-item
            data-search={item.search}
          >
            <span>{item.title}</span>
            <small class={sx('text-gray-500 dark:text-gray-400')}>{item.section}</small>
          </a>
        ))}
        <p class={sx('m-0 p-4 text-center text-gray-500')} data-search-empty hidden>No matching documentation.</p>
      </nav>
    </div>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll('[data-docs-search]')) {
    const trigger = root.querySelector('[data-search-open]');
    const dialog = root.querySelector('[data-search-dialog]');
    const input = root.querySelector('[data-search-input]');
    const close = root.querySelector('[data-search-close]');
    const empty = root.querySelector('[data-search-empty]');
    const results = [...root.querySelectorAll('[data-search-item]')];

    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !(close instanceof HTMLButtonElement) || !(empty instanceof HTMLElement)) continue;

    const filter = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const result of results) {
        const text = result.getAttribute('data-search') ?? '';
        const visible = terms.every((term) => text.includes(term));
        result.toggleAttribute('hidden', !visible);
        if (visible) count += 1;
      }
      empty.hidden = count > 0;
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
    };

    trigger.addEventListener('click', open);
    close.addEventListener('click', () => dialog.close());
    input.addEventListener('input', filter);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      input.value = '';
      filter();
      trigger.focus();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      }
    });
  }
</script>
