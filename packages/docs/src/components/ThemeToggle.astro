---
import { sx } from '@cssxio/cssx';

import Icon from './Icon.astro';
---

<div class="theme-toggle">
  <button data-theme-toggle type="button" aria-label="Toggle dark or light color theme" class={sx('pt-1.2')}>
    <span data-theme-label class="theme-toggle-sun">
      <Icon name="sun" class={sx('h-6 w-6 text-gray-600 dark:text-gray-300')} />
    </span>
    <span data-theme-label class="theme-toggle-moon">
      <Icon name="moon" class={sx('h-6 w-6 text-gray-600 dark:text-gray-300')} />
    </span>
  </button>
</div>

<style>
  .theme-toggle-sun {
    display: none;
  }
  .theme-toggle-moon {
    display: block;
  }
  :where([data-theme='light']) .theme-toggle-sun,
  :where([data-theme='light'] *) .theme-toggle-sun {
    display: block;
  }
  :where([data-theme='light']) .theme-toggle-moon,
  :where([data-theme='light'] *) .theme-toggle-moon {
    display: none;
  }
  .theme-toggle-caption {
    display: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.025em;
  }
  @media (min-width: 640px) {
    .theme-toggle-caption {
      display: inline;
    }
  }
  @media (prefers-color-scheme: dark) {
    :where([data-theme='light']) .theme-toggle-sun,
    :where([data-theme='light'] *) .theme-toggle-sun {
      display: none;
    }
    :where([data-theme='light']) .theme-toggle-moon,
    :where([data-theme='light'] *) .theme-toggle-moon {
      display: block;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function updateLabels() {
    const isDark = document.documentElement.dataset.theme === 'dark';
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(isDark));
      const caption = button.querySelector('[data-theme-label="caption"]');
      if (caption) caption.textContent = isDark ? 'Light' : 'Dark';
    }
  }

  updateLabels();
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      document.documentElement.style.colorScheme = next;
      localStorage.setItem('cssx-theme', next);
      updateLabels();
    });
  }
</script>
