---
import { sx } from '@cssxio/cssx';

import Icon from './Icon.astro';

interface Props {
  class?: string;
}

---

<div class={sx('grid place-items-center', Astro.props.class)}>
  <button class={sx('grid h-6 w-6 place-items-center border-0 bg-transparent p-0 cursor-pointer')} data-theme-toggle type="button" aria-label="Switch color theme between light, dark, and system">
    <span data-theme-label class={sx('hidden [html[data-theme-mode=light]_&]:block')}>
      <Icon name="sun" class={sx('h-5 w-5 text-gray-600 dark:text-gray-300')} />
    </span>
    <span data-theme-label class={sx('hidden [html[data-theme-mode=dark]_&]:block')}>
      <Icon name="moon" class={sx('h-5 w-5 text-gray-600 dark:text-gray-300')} />
    </span>
    <span data-theme-label class={sx('hidden [html[data-theme-mode=system]_&]:block')}>
      <Icon name="device-desktop" class={sx('h-5 w-5 text-gray-600 dark:text-gray-300')} />
    </span>
  </button>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const modes = ['light', 'dark', 'system'] as const;
  type ThemeMode = (typeof modes)[number];
  const prefersDark = matchMedia('(prefers-color-scheme: dark)');

  function currentMode(): ThemeMode {
    const value = document.documentElement.dataset.themeMode as ThemeMode | undefined;
    return value && modes.includes(value) ? value : 'dark';
  }

  function applyMode(mode: ThemeMode) {
    const isDark = mode === 'dark' || (mode === 'system' && prefersDark.matches);
    document.documentElement.dataset.themeMode = mode;
    document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
  }

  function updateLabels() {
    const mode = currentMode();
    const isDark = document.documentElement.dataset.theme === 'dark';
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(isDark));
      const caption = button.querySelector('[data-theme-label="caption"]');
      if (caption) caption.textContent = mode.charAt(0).toUpperCase() + mode.slice(1);
    }
  }

  applyMode(currentMode());
  updateLabels();

  prefersDark.addEventListener('change', () => {
    if (currentMode() === 'system') {
      applyMode('system');
      updateLabels();
    }
  });

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const mode = modes[(modes.indexOf(currentMode()) + 1) % modes.length];
      applyMode(mode);
      localStorage.setItem('cssx-theme', mode);
      updateLabels();
    });
  }
</script>
