---
import { sx } from '@cssxio/cssx';
import type { DocLocale, DocPage } from '../docs/catalog.ts';
import ShowIf from './ShowIf.astro';

interface Props {
  variant: 'desktop' | 'mobile';
  pages: DocPage[];
  lang: DocLocale;
  currentId?: string;
}

const { variant, pages, lang, currentId } = Astro.props;
const docsPath = lang === 'en' ? '/docs' : `/${lang}/docs`;
const groups = ['Start here', 'Utility syntax', 'Utilities', 'Advanced'] as const;
const sections = groups
  .map((title) => ({
    title,
    pages: pages.filter((page) => page.data.section === title).sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((section) => section.pages.length > 0);
---

<ShowIf condition={variant === 'mobile'}>
  <details class={sx('hidden max-md:relative max-md:block')}>
    <summary class={sx('cursor-pointer rounded-lg px-3 py-2 text-sm')} aria-label="Open documentation navigation">Contents</summary>
    <nav
      class={sx(
        'flex flex-col gap-6',
        'in-open:absolute in-open:z-10 in-open:top-full in-open:mt-2 in-open:left-0',
        'in-open:[width:min(20rem,calc(100vw - 2rem))] in-open:max-h-[75dvh] in-open:overflow-auto',
        'in-open:rounded-xl in-open:border in-open:border-gray-200 in-open:bg-white in-open:p-4 in-open:shadow-xl',
        'dark:in-open:border-gray-700 dark:in-open:bg-neutral-900',
      )}
      aria-label="Documentation navigation"
    >
      {sections.map((section) => (
        <section class={sx('flex flex-col gap-1')}>
          <h2 class={sx('m-0 text-xs font-semibold uppercase tracking-widest text-gray-500')}>{section.title}</h2>
          {section.pages.map((page) => (
            <a
              class={sx(
                '-mx-2 rounded-md px-2 py-1 text-sm leading-normal text-gray-600 no-underline',
                'hover:text-gray-900 hover:underline aria-[current=page]:bg-gray-100 aria-[current=page]:text-gray-900',
                'dark:text-gray-300 dark:hover:text-gray-50 dark:aria-[current=page]:bg-neutral-800 dark:aria-[current=page]:text-gray-50',
              )}
              href={`${docsPath}/${page.id}`}
              aria-current={page.id === currentId ? 'page' : undefined}
            >
              {page.data.title}
            </a>
          ))}
        </section>
      ))}
    </nav>
  </details>
</ShowIf>
<ShowIf condition={variant === 'desktop'}>
  <aside
    class={sx(
      'fixed top-22 bottom-4 [left:max(1.5rem,calc((100vw - var(--container-7xl))/2))] z-10',
      '-ml-2 box-border flex w-56 flex-col gap-5 overflow-auto overscroll-contain pl-2 pr-4',
      'max-docs:w-52 max-md:hidden',
    )}
  >
    <nav class={sx('flex flex-col gap-6')} aria-label="Documentation navigation">
      {sections.map((section) => (
        <section class={sx('flex flex-col gap-1')}>
          <h2 class={sx('m-0 text-xs font-semibold uppercase tracking-widest text-gray-500')}>{section.title}</h2>
          {section.pages.map((page) => (
            <a
              class={sx(
                '-mx-2 rounded-md px-2 py-1 text-sm leading-normal text-gray-600 no-underline',
                'hover:text-gray-900 hover:underline hover:underline-offset-1 aria-[current=page]:bg-gray-100 aria-[current=page]:text-gray-900',
                'dark:text-gray-300 dark:hover:text-gray-50 dark:aria-[current=page]:bg-neutral-800 dark:aria-[current=page]:text-gray-50',
              )}
              href={`${docsPath}/${page.id}`}
              aria-current={page.id === currentId ? 'page' : undefined}
            >
              {page.data.title}
            </a>
          ))}
        </section>
      ))}
    </nav>
    <footer class={sx('flex gap-4 border-t border-gray-200 px-2 pt-4 dark:border-gray-800')}>
      <a class={sx('text-xs text-gray-500 no-underline hover:text-gray-900 dark:hover:text-gray-50')} href="https://github.com/liberocks/cssx" target="_blank" rel="noreferrer">GitHub</a>
      <a class={sx('text-xs text-gray-500 no-underline hover:text-gray-900 dark:hover:text-gray-50')} href="https://www.npmjs.com/package/@cssxio/cssx" target="_blank" rel="noreferrer">npm</a>
    </footer>
  </aside>
</ShowIf>
