{
  "name": "@cssxio/cssx",
  "version": "0.3.0",
  "description": "Compile-time utility styling runtime for CSSX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liberocks/cssx.git",
    "directory": "packages/cssx"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify --clean"
  }
}
