{
  "name": "@cssxio/compiler",
  "version": "0.4.1",
  "description": "Standalone utility compiler for CSSX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liberocks/cssx.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/write-build-manifest.mjs"
  }
}
